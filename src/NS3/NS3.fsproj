<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <AssemblyName>ns</AssemblyName>
    <Nullable>disable</Nullable>
    <WarningLevel>3</WarningLevel>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <NoWarn>FS0025</NoWarn>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Ast.fs" />
    <Compile Include="Stdlib.fs" />
    <Compile Include="Lexer.fs" />
    <Compile Include="Parser.fs" />
    <Compile Include="Core.fs" />
    <Compile Include="Desugar.fs" />
    <Compile Include="Lower.fs" />
    <Compile Include="Typer.fs" />
    <Compile Include="Repr.fs" />
    <Compile Include="Codegen.fs" />
    <Compile Include="Program.fs" />
    <!-- the runtime is precompiled to LLVM IR at build time and embedded; programs are merged with it -->
    <EmbeddedResource Include="$(IntermediateOutputPath)runtime.ll" LogicalName="runtime.ll" />
    <!-- runtime.c's //@ lines declare the stdlib signatures -->
    <EmbeddedResource Include="runtime.c" LogicalName="runtime.c" />
  </ItemGroup>

  <Target Name="CompileRuntime" BeforeTargets="BeforeBuild" Inputs="runtime.c" Outputs="$(IntermediateOutputPath)runtime.ll">
    <MakeDir Directories="$(IntermediateOutputPath)" />
    <Exec Command="clang -S -emit-llvm -O2 -w runtime.c -o $(IntermediateOutputPath)runtime.ll" />
  </Target>

</Project>
