# Dijkstra on an undirected weighted graph with a PQ of (dist,node) tuples;
# prints distances from node 0 and the shortest path to node 4.
n = 5
e = [(0,1,4),(0,2,1),(2,1,2),(1,3,1),(2,3,5),(3,4,3)]
e = e++e{(_@1,_@0,_@2)}
d = [1000000000]*n; d@0 = 0
pr = [-1]*n
q = PQ[(0,0)]
q ~{
  du,u = q.pop
  e[(_@0)=u & du+_@2<d@(_@1)]{v=_@1; d@v = du+_@2; pr@v = u; q+=(d@v,v)}
}
print:d
p = [4]
p@-1~=0 ~{p ++= pr@(p@-1)}
print:p.rev.join:" -> "
