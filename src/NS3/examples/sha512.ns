# SHA-512 of each stdin line, as lowercase hex.
# No unsigned ints, hex literals or rotate: constants ≥ 2^63 are negative decimals,
# and logical shift / rotate are built from the arithmetic >>.
K = [
  4794697086780616226,8158064640168781261,-5349999486874862801,-1606136188198331460,
  4131703408338449720,6480981068601479193,-7908458776815382629,-6116909921290321640,
  -2880145864133508542,1334009975649890238,2608012711638119052,6128411473006802146,
  8268148722764581231,-9160688886553864527,-7215885187991268811,-4495734319001033068,
  -1973867731355612462,-1171420211273849373,1135362057144423861,2597628984639134821,
  3308224258029322869,5365058923640841347,6679025012923562964,8573033837759648693,
  -7476448914759557205,-6327057829258317296,-5763719355590565569,-4658551843659510044,
  -4116276920077217854,-3051310485924567259,489312712824947311,1452737877330783856,
  2861767655752347644,3322285676063803686,5560940570517711597,5996557281743188959,
  7280758554555802590,8532644243296465576,-9096487096722542874,-7894198246740708037,
  -6719396339535248540,-6333637450476146687,-4446306890439682159,-4076793802049405392,
  -3345356375505022440,-2983346525034927856,-860691631967231958,1182934255886127544,
  1847814050463011016,2177327727835720531,2830643537854262169,3796741975233480872,
  4115178125766777443,5681478168544905931,6601373596472566643,7507060721942968483,
  8399075790359081724,8693463985226723168,-8878714635349349518,-8302665154208450068,
  -8016688836872298968,-6606660893046293015,-4685533653050689259,-4147400797238176981,
  -3880063495543823972,-3348786107499101689,-1523767162380948706,-757361751448694408,
  500013540394364858,748580250866718886,1242879168328830382,1977374033974150939,
  2944078676154940804,3659926193048069267,4368137639120453308,4836135668995329356,
  5532061633213252278,6448918945643986474,6902733635092675308,7801388544844847127]
H0 = [7640891576956012808,-4942790177534073029,4354685564936845355,-6534734903238641935,5840696475078001361,-7276294671716946913,2270897969802886507,6620516959819538809]
shr = {_1>>_2 & (1<<64-_2)-1}            # logical right shift, 0<n<64
r = {(shr:_1,_2) | _1<<64-_2}            # rotate right
hex = {v = _; 0..16{"0123456789abcdef"@(v>>60-4*_ & 15)}/+}
lines{
  # padding: bytes ++ 0x80 ++ zeros to 112 mod 128 ++ 128-bit big-endian bit length
  m = _{ord:_}; n = #m*8
  m = m++128
  m = m++[0]*((240-#m%128)%128)++[0]*8++0..8{n>>56-8*_ & 255}
  hs = H0; i = 0
  i<#m ~{
    # message schedule: 16 big-endian words, then expand to 80
    w = [0]*80; t = 0
    t<16 ~{ j = i+8*t; w@t = 0..8{m@(j+_)}/{$<<8|_}; t+=1 }
    t<80 ~{
      x = w@(t-15); y = w@(t-2)
      w@t = w@(t-16) + ((r:x,1)^(r:x,8)^(shr:x,7)) + w@(t-7) + ((r:y,19)^(r:y,61)^(shr:y,6))
      t+=1
    }
    # compression: 80 rounds over the working variables a..h
    a,b,c,d,e,f,g,h = hs
    t = 0
    t<80 ~{
      t1 = h + ((r:e,14)^(r:e,18)^(r:e,41)) + (e&f ^ (e^-1)&g) + K@t + w@t
      t2 = ((r:a,28)^(r:a,34)^(r:a,39)) + (a&b ^ a&c ^ b&c)
      h,g,f,e,d,c,b,a = g,f,e,d+t1,c,b,a,t1+t2
      t+=1
    }
    hs = hs+[a,b,c,d,e,f,g,h]
    i+=128
  }
  # output: 16 nibbles per word; arithmetic >> is fine since each nibble is masked
  print:hs{hex:_}/+
}
