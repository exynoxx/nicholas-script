# BFS shortest path on a grid read from stdin, S to E, '#' is a wall.
# Cells are (row,col) tuples, located with find and used as map keys.
h = int:read
g = 0..h{read}
w = #(g@0)
z = g.join:""
f = {i = find:z,_; (i/w,i%w)}
s = f:"S"; e = f:"E"
d = [s->0]; q = Q[s]
q ~{
  p = q.pop; y,x = p
  [(y+1,x),(y-1,x),(y,x+1),(y,x-1)][r=_@0; c=_@1; r>=0 & r<h & c>=0 & c<w & !(d@?_) & (g@r)@c!="#"]{d@_ = d@p+1; q+=_}
}
print:d@?e ? "shortest S->E: {d@e}" : "unreachable"
print:"reachable cells: {#d}"
