# BFS shortest path on a grid read from stdin, S to E, '#' is a wall.
# Cells are (row,col) tuples, located with find and used as map keys.
h = int:read
g = 0..h{read}
w = #(g@0)
z = g.join:""
f = {i = find:z,_; (i/w,i%w)}
s = f:"S"; e = f:"E"
d = [s->0]; q = Q[s]
q{p = _; (nb4:p,w,h)[!(d@?_) & (g@_1)@_2!="#"]{d@_ = d@p+1; q+=_}}
println:d@?e ? "shortest S->E: {d@e}" : "unreachable"
println:"reachable cells: {#d}"
