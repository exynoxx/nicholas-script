# Number of islands: recursive flood fill over "1" land cells, a set of seen
# [row,col] pairs, and island sizes collected per fill.
g = ["11000","11000","00100","00011","10101"]
h = #g; w = #(g@0)
seen = %[]
ok = {y=_@0; x=_@1; y>=0 & y<h & x>=0 & x<w & !(seen@?_) & (g@y)@x="1"}
sz = 0
dfs = {
  [_][ok:_]{seen+=_; sz+=1; p=_; [[1,0],[-1,0],[0,1],[0,-1]]{p+_}{dfs:_}}
  0
}
sizes = []
(0..h){i=_; (0..w){[[i,_]][ok:_]{sz=0; dfs:_; sizes++=sz}}}
print:#sizes
print:sizes.sort
