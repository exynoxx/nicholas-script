# Functional quicksort, checked against .sort: pivot on the first element, recurse on the <p and >p parts.
q = {p = #_ ? _@0 : 0; #_<2 ? _ : (q:_[<p])++_[=p]++(q:_[>p])}
x = [5,-3,8,0,5,-3,12,1,-7,8,8,2]
s = 42
r = 0..20{s = (s*1103515245+12345)%2147483648; s%100-50}
[x,r]{
  println:"in:  {_}"
  f = q:_
  println:"out: {f}"
  println:"ok:  {f=_.sort}"
}
