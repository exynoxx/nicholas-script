# Two-sum: one pass with a value->index map; prints the index pair adding to t.
ts = {
  a = _1; t = _2; m = [->]; r = [-1,-1]
  (0..#a){i = _; [t-a@i][m@?_]{r = [m@_, i]}; m@(a@i) = i}
  r
}
println:ts:[2,7,11,15],9
println:ts:[3,2,4],6
println:ts:[3,3],6
println:ts:[1,5,8,4],12
println:ts:[1,2],7
