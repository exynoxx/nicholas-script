# recursion: an in-order walk of a search tree stored as a heap (children of i: 2i+1, 2i+2)
tree = [8, 4, 12, 2, 6, 10, 14, 1, 3, 5, 7, 9, 11, 13, 15]
seen = 0
lazy walk i = {
  seen += 1
  i < #tree ? (walk:2*i+1) ++ [tree@i] ++ walk:2*i+2 : []
}
println:(walk:0).take:2
println:seen                            # 6 calls, not 31
seen = 0
println:walk:0
println:seen
seen = 0
println:(walk:0)[_ > 4].one
println:seen
seen = 0
k = 2
println:(walk:0)@k
println:seen
seen = 0
println:(walk:0){_ < 3}.all
println:seen
seen = 0
println:(walk:0){_ > 2}/|
println:seen
seen = 0
println:(walk:0){_ < 9}/&
println:seen
