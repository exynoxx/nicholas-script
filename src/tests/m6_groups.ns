print:f:21
print:f:21
g = [[1,2],[3],[3],[]]
d = [-1]*4; d@0 = 0; q = Q[0]
q ~{ u = q.pop; g@u{d@_<0 ? (d@_ = d@u+1; q += _)} }
print:d
