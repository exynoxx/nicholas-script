# m ?? d: missing keys of m read as d (no insert); without it a missing key is an error
c = [->] ?? 0
"hello"{c@_ += 1}
println:c@"l"
println:c@"z"
println:#c
g = [->] ?? []
[(1,2),(1,3),(2,4)]{g@_1 ++= [_2]}
println:g@1
println:g@9
s = ["k"->"v"] ?? "none"
println:s@"q"
f = ["x"->1.5]
f ?? 0.0
f@"y" *= 2
println:f@"y"
nested = [1->[2->3] ?? 0]
println:nested@1@7
