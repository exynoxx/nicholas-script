# literals and conversion
g = G[(1,2),(2,3)]
println:g
d = DG[(1,2),(2,3)]
println:d
w = G[(1,2,4),(2,3,1)]
println:w
e = G[]
e += (5,6)
println:e
println:G:[(1,2)]
# indexing and contains
println:(g@2).sort
println:d@2
println:d@3
println:w@(1,2)
println:w@(1,3)
println:[g@?2, g@?9, g@?(2,1), d@?(2,1), d@?(1,2)]
# add / remove
g += (3,4,7)
println:g@(4,3)
g -= (1,2)
println:[g@?(1,2), g@?1]
g -= 3
println:[#g, g@?3, #g@2]
# size, degree
println:[#w, #w@2]
# map and filter over nodes
c = w{#_}
println:[c@1, c@2, c@3]
println:w[#_>1].nodes
println:(w[_@?3]).edges.sort
# set ops and reverse
a = DG[(1,2),(2,3)]
b = DG[(2,3),(3,4)]
println:((a|b).edges.sort)
println:((a&b).edges.sort)
println:((a-b).edges.sort)
println:(-a).edges.sort
println:(w.nodes).sort
println:w.edges.sort
# string nodes, tuples as nodes
s = G[("a","b",1),("b","c",2)]
println:(s@"b").sort
println:s@("b","c")
t = G[((0,0),(0,1))]
println:t@(0,0)
println:t@?((0,1),(0,0))
