# open-ended slices: x@..n from the start, x@i.. to the end; x@-k.. starts at -k
x = [5,6,7,8,9]
k = 2
println:x@..2
println:x@1..
println:x@-2..
println:x@-k..
println:x@-k..x
println:x@..-1
println:x@1..3
println:x@..k+1
println:(x@1..){*10}
println:x@-1
println:"hello"@1..
println:"hello"@..2
println:(x@3.. = [8,9]) ? "y" : "n"
lookup = [8->0, 1->1, 9->6, 2->11]
a,b = lookup${-_1}@..2${_2}{_1}
println:[a,b]
