# arrows: `test => value` in a block or group; the first test that holds gives the value, the last line is the default
x = 3
println: (x=1 => "one"; x=2, x=3 => "few"; "many")
# in a block, a leading comparison tests `_`
grade = { >=90 => "A"; >=80 => "B"; "C" }
println:grade:85
x = 7
println: (x<0 => "neg"; x=0 => "zero"; x<10 => "small"; "big")
# a bare literal compares `_` with it; the argument is computed once
n = 0
f = { n += 1; 2 }
pick = { 1 => "a"; 2 => "b"; "c" }
println: pick: f:0
println:n
s = "b"
println: (s="a" => 1; s="b" => 2; 0)
# nested: an arrow's value may be a group of arrows
println:(1..6){ _%2=0 => (2 => "two"; "even"); "odd" }
# without a default: a statement (arrows run for effect)
c = 0
[1,5,9]{ 5 => c += 10; 9 => c += 100 }
println:c
# in a map block, _ is the element
println:[1,2,3,9]{ 1 => "one"; 2, 3 => "few"; "many" }
println:[95,85,10]{ >=90 => "A"; >=80 => "B"; "C" }
println:[1,5,12]{ >10 => _*100; _ }
# ?[ ] keeps the elements matching an arm (an arm may give an explicit bool)
println:[1,2,5,7,9,12] ?[ 1, 2; >8 ]
println:[1,2,5,7,9,12] ?[
  >10 => F
  >6
]
println:["ab","cd","ef"] ?[ "cd" ]
# `c ?[..] : d` is still a ternary with an array literal
println:T?[1]:[2]
println:F ?[[1],[2]] : [[3]]
y = 7
println: (y=1 => "one"; "other")
println: (F => 1; 2)
println:[1,2,3]{ 2 => "two"; "-" }
println:[1,5,9] ?[ 5 => F; _ => T ]
# arrays compare whole with =
l = [1,2,3]
println: (l=[1,2,3] => "exact"; "other")
m = [3,4]
println: (m=[1,2,3] => "exact"; #m=0 => "empty"; "other")
println: (m<[4] => "before [4]"; "after")
