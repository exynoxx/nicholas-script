# chain@k stops the fused loop after k+1 results
c = 0
r = 1..1000000[c += 1; _ > 5]@0
println:"{r} {c}"
c = 0
r = 1..1000000[c += 1; _ > 5]@2
println:"{r} {c}"
c = 0
xs = [1,2,3,4,5,6]
println:xs{c += 1; _*2}[>3]@1
println:c
println:xs@0
k = 1
c = 0
println:xs[c += 1; _ > 2]@k
println:c
k = -1
println:xs[_ > 2]@k
println:"hello"[_ != "h"]@1
?? println:xs[_ > 9]@0
?? println:xs[_ > 4]@5
println:"end"
