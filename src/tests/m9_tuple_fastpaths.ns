# boxed tuple members read in place (bool before an int: packed, unaligned)
t = (T, 7, "ab", 2.5)
println: t._1
println: t._2
println: t._3 + "c"
println: t._4
ps = [(1, "x"), (2, "y"), (3, "x")]
println: ps {_2} .join
# value tuple equality, inline
println: (1, 2) = (1, 2)
println: (1, 2) = (1, 3)
println: (1, 2) != (2, 1)
println: (1.5, T) = (1.5, T)
println: (0.0, F) != (0.0, T)
# counting a filter without collecting it
xs = 1..11
println: #xs[_ % 3 = 0]
println: #xs{_ * _}[_ > 50]
println: #ps[_2 = "x"]
println: #10[>6]
println: #(xs[_ > 100])
println: #"hello"[_ = "l"]
println: #(map: [(1, 2), (3, 4)])[_ > 2]
