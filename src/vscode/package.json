{
  "name": "ns-lang",
  "displayName": "NS",
  "description": "Syntax highlighting and error squiggles for the NS golf language",
  "version": "0.3.0",
  "publisher": "nicholas",
  "engines": {
    "vscode": "^1.60.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "contributes": {
    "languages": [
      {
        "id": "ns",
        "aliases": [
          "NS"
        ],
        "extensions": [
          ".ns"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "ns",
        "scopeName": "source.ns",
        "path": "./syntaxes/ns.tmLanguage.json"
      }
    ],
    "configuration": {
      "title": "NS",
      "properties": {
        "ns.path": {
          "type": "string",
          "default": "ns",
          "description": "Path to the ns compiler (used for `ns check`)."
        }
      }
    }
  },
  "main": "./extension.js",
  "activationEvents": [
    "onLanguage:ns"
  ]
}
