{
  "name": "ns-lang",
  "displayName": "NS",
  "description": "Syntax highlighting for the NS golf language",
  "version": "0.2.0",
  "publisher": "nicholas",
  "engines": { "vscode": "^1.60.0" },
  "categories": ["Programming Languages"],
  "contributes": {
    "languages": [{
      "id": "ns",
      "aliases": ["NS"],
      "extensions": [".ns"],
      "configuration": "./language-configuration.json"
    }],
    "grammars": [{
      "language": "ns",
      "scopeName": "source.ns",
      "path": "./syntaxes/ns.tmLanguage.json"
    }]
  }
}
